# AutoComm API Configuration
AUTOCOMM_BASE_URL=https://YOUR_AUTOCOMM_URL/api
AUTOCOMM_API_KEY=YOUR_KEY
AUTOCOMM_API_SECRET=YOUR_SECRET
AUTOCOMM_CHANNEL_ID=YOUR_CHANNEL_ID
AUTOCOMM_GROUP_ID=YOUR_GROUP_ID
AUTOCOMM_TEMPLATE_NAME=YOUR_APPROVED_TEMPLATE
AUTOCOMM_WA_CAMPAIGN_ID=YOUR_WHATSAPP_CAMPAIGN_ID
AUTOCOMM_CALL_CAMPAIGN_ID=YOUR_CALLING_CAMPAIGN_ID

# Admin & Security
ADMIN_PASSWORD=CHANGE_ME
WEBHOOK_SECRET=CHANGE_ME

# Operational Flags
# Set to 'true' to simulate AutoComm responses locally without real credentials
MOCK_AUTOCOMM=true
PORT=3000
NODE_ENV=development
