# ============================================================
# AutoComm - Environment Configuration Example
# ============================================================

# General Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5173
SUPERADMIN_URL=http://localhost:5174

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/autocomm

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiries
JWT_ACCESS_SECRET=autocomm_access_super_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=autocomm_refresh_super_secret_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Super Admin JWT
SUPERADMIN_JWT_SECRET=autocomm_superadmin_secret_key_secure_vault_2026
SUPERADMIN_JWT_EXPIRES_IN=8h

# Field Encryption Secret (AES-256: 32 bytes hex or 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Nodemailer / Email Provider
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@autocomm.io
EMAIL_FROM_NAME="AutoComm Operations"

# WhatsApp Cloud API (Default Sandbox)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=autocomm_meta_webhook_secret_token

# Telephony Providers (Twilio / Plivo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALL_STATUS_CALLBACK=http://localhost:5000/api/v1/webhooks/telephony/twilio

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
